{
  "name": "milos-stankovic/fast-corporation-php-task",
  "description": "Vanilla PHP technical task with user activity tracking.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-session": "*",
    "ext-sqlite3": "*",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.7",
    "friendsofphp/php-cs-fixer": "^3.95",
    "nikic/php-parser": "^5.9",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "InterviewTask\\Accounts\\": "src/Accounts/",
      "InterviewTask\\ActivityTracking\\": "src/ActivityTracking/",
      "InterviewTask\\CowOffer\\": "src/CowOffer/",
      "InterviewTask\\Downloads\\": "src/Downloads/",
      "InterviewTask\\Runtime\\": "runtime/",
      "InterviewTask\\Infrastructure\\": "infrastructure/",
      "InterviewTask\\Bootstrap\\": "bootstrap/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "InterviewTask\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check:composer": "composer validate --strict",
    "security:audit": "composer audit --locked --no-interaction",
    "test": "phpunit",
    "stan": "phpstan analyse --no-progress",
    "docs:check": "php tools/check-phpdocs.php",
    "rector:scan": "rector process --dry-run --no-progress-bar --memory-limit=1G",
    "architecture": "deptrac analyse --config-file=tools/architecture.yaml --fail-on-uncovered",
    "quality": [
      "@check:composer",
      "@check:psr4",
      "@moi:self-test",
      "@moi:check",
      "@security:audit",
      "@docs:check",
      "@stan",
      "@architecture",
      "@test"
    ],
    "check:psr4": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
    "moi:self-test": "php tools/check-moi-conventions.php --self-test",
    "moi:check": "php tools/check-moi-conventions.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
