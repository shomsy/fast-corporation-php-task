APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080
DB_PATH=var/database/app.sqlite
SESSION_COOKIE_SECURE=0
# Production only: precreate a private (0700) writable directory outside public/.
# SESSION_STORAGE_PATH=/secure/private/session-directory

# Explicit document route ownership. Default SSR; change to spa after browser acceptance.
UI_ENTRYPOINT=spa
