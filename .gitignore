/vendor/
/.env
/.deptrac.cache
/.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan.cache
/var/phpstan/
/var/database/*.sqlite
/var/database/*.sqlite-*
/var/log/*
!/var/log/.gitkeep
!/var/database/.gitkeep

# Python probe bytecode (never part of release evidence)
__pycache__/

# Local editor state
/.idea/
/.gigaide/

# Locally exported PhpStorm inspection reports (retain outside Git)
/var/phpstorm-inspections/

# Local backups of pre-existing IDE changes
/var/manual-backups/

# Rector dry-run reports (local review evidence)
/var/rector/

# Development-only Playwright runner
/node_modules/
/playwright-report/
/test-results/

# Local design and review materials
/docs/
/AGENTS.md
/IMPLEMENTATION-PLAN.md
/tools/check_execution_ledger.py
/tools/check-final-audit.py
/.aiforopenide/
